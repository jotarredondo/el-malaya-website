---
interface Props {
    platform: 'spotify' | 'youtube';
    title: string;
    description?: string;
    imageSrc?: string;
    href?: string;
}

const {
    platform,
    title,
    description,
    imageSrc,
    href
} = Astro.props;

const platformLabel =
    platform === 'spotify' ? 'SPOTIFY / PLAYLIST' : 'YOUTUBE / VIDEO';

const actionLabel =
    platform === 'spotify' ? 'Abrir en Spotify' : 'Abrir en YouTube';
---

<article class:list={['media-card', `media-card--${platform}`]}>
    <div class="media-card__cover">
        {imageSrc ? (
                <img
                        src={imageSrc}
                        alt={`Imagen de ${title}`}
                        loading="lazy"
                        decoding="async"
                />
        ) : (
                <div class="media-card__placeholder" aria-hidden="true">
                    <span>{platform === 'spotify' ? '♫' : '▶'}</span>
                </div>
        )}
    </div>

    <div class="media-card__body">
        <span class="media-card__label">{platformLabel}</span>

        <h3>{title}</h3>

        {description && <p>{description}</p>}

        {href ? (
                <a
                        class="media-card__link"
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                >
                    {actionLabel} <span aria-hidden="true">↗</span>
                </a>
        ) : (
                <span class="media-card__pending">
        Contenido de muestra
      </span>
        )}
    </div>
</article>

<style>
    .media-card {
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);

        transition:
                transform var(--transition-normal),
                border-color var(--transition-normal),
                box-shadow var(--transition-normal);
    }

    .media-card:hover {
        transform: translateY(-4px);
        border-color: var(--color-accent-primary);
        box-shadow: var(--glow-pink);
    }

    .media-card__cover {
        overflow: hidden;
        background: var(--color-panel);
    }

    .media-card--spotify .media-card__cover {
        aspect-ratio: 1 / 1;
    }

    .media-card--youtube .media-card__cover {
        aspect-ratio: 16 / 9;
    }

    .media-card__cover img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .media-card__placeholder {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        background:
                radial-gradient(
                        circle at 75% 25%,
                        rgba(241, 109, 151, 0.4),
                        transparent 55%
                ),
                linear-gradient(
                        135deg,
                        var(--color-panel),
                        var(--color-bg)
                );
    }

    .media-card--youtube .media-card__placeholder {
        background:
                radial-gradient(
                        circle at 70% 30%,
                        rgba(17, 169, 207, 0.35),
                        transparent 55%
                ),
                linear-gradient(
                        135deg,
                        var(--color-panel),
                        var(--color-bg)
                );
    }

    .media-card__placeholder span {
        font-size: 3.5rem;
        color: var(--color-text-primary);
    }

    .media-card__body {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding: 24px;
    }

    .media-card__label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        color: var(--color-accent-primary);
    }

    .media-card h3 {
        margin: 0;
        font-family: var(--font-heading);
        font-size: 1.25rem;
        line-height: 1.3;
    }

    .media-card p {
        margin: 0;
        color: var(--color-text-secondary);
        font-size: 0.875rem;
    }

    .media-card__link {
        margin-top: auto;
        padding-top: 8px;
        color: var(--color-accent-secondary);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }

    .media-card__link:hover {
        text-decoration: underline;
    }

    .media-card__pending {
        margin-top: auto;
        padding-top: 8px;
        color: var(--color-text-secondary);
        font-size: 0.75rem;
        font-family: var(--font-mono);
    }
</style>
